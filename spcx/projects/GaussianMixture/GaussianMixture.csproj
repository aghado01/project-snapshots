<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Assembly name differs from namespace: GMM types live in StatisticalEstimators
         so that existing consumers (e.g. SpcCore via spc.graph.cs) require no changes. -->
    <RootNamespace>StatisticalEstimators</RootNamespace>
    <AssemblyName>GaussianMixture</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\gmm\*.cs" Link="gmm\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinearAlgebra\LinearAlgebra.csproj" />
    <ProjectReference Include="..\DistanceMetrics\DistanceMetrics.csproj" />
  </ItemGroup>
</Project>
